# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# App URL (used for OAuth redirect)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Anthropic API key (playlist auto-titling)
ANTHROPIC_API_KEY=

# last.fm API key (optional). Enables the contrast-class tag veto — drops
# mislabeled filler (e.g. a "smooth jazz" act in a hard-bop playlist) that
# audio features can't reject. Unset = feature no-ops, pipeline unaffected.
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Session encryption secret (generate with: openssl rand -base64 32)
# Signs the anonymous session cookie and encrypts Spotify tokens at rest.
SESSION_SECRET=

# Postgres connection string. Leave unset for local dev — an embedded
# Postgres (PGlite) in .pglite/ is used automatically.
# DATABASE_URL=

# Secret protecting /api/cron/refresh (scheduled playlist regeneration).
# Vercel sets the Authorization header from this automatically for crons.
# CRON_SECRET=
