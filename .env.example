# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# App URL (used for OAuth redirect)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Anthropic API key (playlist auto-titling)
ANTHROPIC_API_KEY=

# Session encryption secret (generate with: openssl rand -base64 32)
# Signs the anonymous session cookie and encrypts Spotify tokens at rest.
SESSION_SECRET=

# Postgres connection string. Leave unset for local dev — an embedded
# Postgres (PGlite) in .pglite/ is used automatically.
# DATABASE_URL=
